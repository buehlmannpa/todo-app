# Postgres (Vercel Postgres / Neon) -- Connection String mit Pooling
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Zufaelliger Schluessel fuer die Session Signatur (min. 32 Zeichen)
# Erzeugen mit: openssl rand -base64 48
AUTH_SECRET=""

# Web Push VAPID Schluessel, erzeugen mit: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:du@example.com"

# Schutz fuer den Cron Endpunkt (wird von Vercel automatisch gesetzt)
CRON_SECRET=""
